generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────── Enums ─────────────
// Keep in sync with api/src/common/shared/enums.ts (and the web/mobile copies).

enum Role {
  DONOR
  CASE_OFFICER
  FINANCE_VERIFIER
  STAFF
  ADMIN
  COLLECTOR
}

enum Locale {
  ar
  en
}

enum Currency {
  SYP
  USD
}

/// Medical only for the PoC; future campaign types are added here.
enum CampaignType {
  MEDICAL
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  FUNDED
  COMPLETED
  CLOSED
}

enum CaseCategory {
  SURGERY
  MEDICATION
  INCUBATOR
  ONCOLOGY
  TRANSPORT
  OTHER
}

enum CaseStatus {
  SUBMITTED
  UNDER_REVIEW
  NEEDS_INFO
  APPROVED
  REJECTED
  PUBLISHED
  CLOSED
}

enum CaseRoute {
  CROWDFUNDING
  AGA_KHAN_REFERRAL
  MONTHLY_BUDGET
}

enum Priority {
  VERY_URGENT
  URGENT
  NORMAL
}

enum DocumentKind {
  MEDICAL_REPORT
  ID_DOCUMENT
  HOSPITAL_QUOTE
  HOSPITAL_INVOICE
  OTHER
}

enum CollectionPointType {
  MOSQUE
  CENTER
  OFFICE
  SHOP
  OTHER
}

enum PledgeChannel {
  PLATFORM
  COUNCIL
  COLLECTOR
}

enum PaymentMethod {
  BEMO_TRANSFER
  BANK_TRANSFER
  E_WALLET
  CASH
  SHAM_CASH // demo simulation only
  PAYPAL // demo simulation only
  VISA // demo simulation only
}

enum PledgeStatus {
  PLEDGED
  RECEIPT_UPLOADED
  COLLECTED
  VERIFIED
  REJECTED
  CANCELLED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ImportKind {
  BENEFICIARIES
}

enum ImportStatus {
  PREVIEW
  COMMITTED
  FAILED
}

// ───────────── Models ─────────────

model User {
  id           String   @id @default(uuid()) @db.Uuid
  fullName     String   @map("full_name")
  phone        String   @unique
  email        String?  @unique
  passwordHash String?  @map("password_hash")
  role         Role     @default(DONOR)
  locale       Locale   @default(ar)
  isActive     Boolean  @default(true) @map("is_active")
  localCouncil String?  @map("local_council")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  pledges          Pledge[]          @relation("DonorPledges")
  recordedPledges  Pledge[]          @relation("RecordedPledges")
  receipts         Receipt[]
  verifications    Verification[]
  submittedCases   Case[]            @relation("SubmittedCases")
  reviewedCases    Case[]            @relation("ReviewedCases")
  campaigns        Campaign[]
  documents        Document[]
  disbursements    Disbursement[]
  campaignUpdates  CampaignUpdate[]
  collectionPoints CollectionPoint[] @relation("CollectorPoints")
  auditLogs        AuditLog[]
  importJobs       ImportJob[]
  notifications    Notification[]

  @@map("users")
}

model Beneficiary {
  id              String   @id @default(uuid()) @db.Uuid
  fullName        String   @map("full_name")
  phone           String?
  nationalIdHash  String?  @map("national_id_hash")
  nationalIdLast4 String?  @map("national_id_last4")
  localCouncil    String?  @map("local_council")
  otherPrograms   String[] @map("other_programs")
  isSuspended     Boolean  @default(false) @map("is_suspended")
  suspensionNote  String?  @map("suspension_note")
  importJobId     String?  @map("import_job_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  cases     Case[]
  importJob ImportJob? @relation(fields: [importJobId], references: [id], onDelete: SetNull)

  @@index([nationalIdHash])
  @@index([phone])
  @@map("beneficiaries")
}

model Hospital {
  id        String  @id @default(uuid()) @db.Uuid
  nameAr    String  @map("name_ar")
  nameEn    String? @map("name_en")
  city      String
  isPrivate Boolean @default(false) @map("is_private")
  isActive  Boolean @default(true) @map("is_active")

  cases         Case[]
  campaigns     Campaign[]
  disbursements Disbursement[]

  @@map("hospitals")
}

model Case {
  id              String       @id @default(uuid()) @db.Uuid
  trackingNo      String       @unique @map("tracking_no")
  beneficiaryId   String       @map("beneficiary_id") @db.Uuid
  category        CaseCategory
  description     String // internal: full description
  requestedAmount Decimal      @map("requested_amount") @db.Decimal(14, 2)
  currency        Currency     @default(SYP)
  status          CaseStatus   @default(SUBMITTED)
  priority        Priority?
  route           CaseRoute?
  hospitalId      String?      @map("hospital_id") @db.Uuid
  doctorName      String?      @map("doctor_name")
  approvedAmount  Decimal?     @map("approved_amount") @db.Decimal(14, 2)
  isAnonymous     Boolean      @default(true) @map("is_anonymous")
  redactedSummary String?      @map("redacted_summary") // what the public sees
  rejectionReason String?      @map("rejection_reason")
  submittedById   String       @map("submitted_by_id") @db.Uuid
  reviewedById    String?      @map("reviewed_by_id") @db.Uuid
  reviewedAt      DateTime?    @map("reviewed_at")
  slaDueAt        DateTime?    @map("sla_due_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  beneficiary Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Restrict)
  hospital    Hospital?   @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  submittedBy User        @relation("SubmittedCases", fields: [submittedById], references: [id], onDelete: Restrict)
  reviewedBy  User?       @relation("ReviewedCases", fields: [reviewedById], references: [id], onDelete: SetNull)
  documents   Document[]
  campaign    Campaign?

  @@index([status, priority])
  @@map("cases")
}

model Campaign {
  id              String         @id @default(uuid()) @db.Uuid
  slug            String         @unique
  type            CampaignType   @default(MEDICAL)
  caseId          String?        @unique @map("case_id") @db.Uuid
  isOngoing       Boolean        @default(false) @map("is_ongoing")
  titleAr         String         @map("title_ar")
  titleEn         String?        @map("title_en")
  summaryAr       String         @map("summary_ar")
  summaryEn       String?        @map("summary_en")
  priority        Priority       @default(NORMAL)
  targetAmount    Decimal        @map("target_amount") @db.Decimal(14, 2)
  currency        Currency       @default(SYP)
  hospitalId      String?        @map("hospital_id") @db.Uuid
  status          CampaignStatus @default(DRAFT)
  acceptsPledges  Boolean        @default(true) @map("accepts_pledges")
  verifiedAmount  Decimal        @default(0) @map("verified_amount") @db.Decimal(14, 2)
  disbursedAmount Decimal        @default(0) @map("disbursed_amount") @db.Decimal(14, 2)
  publishedAt     DateTime?      @map("published_at")
  createdById     String         @map("created_by_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  case          Case?            @relation(fields: [caseId], references: [id], onDelete: Restrict)
  hospital      Hospital?        @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  createdBy     User             @relation(fields: [createdById], references: [id], onDelete: Restrict)
  pledges       Pledge[]
  updates       CampaignUpdate[]
  disbursements Disbursement[]

  @@index([status, type, priority])
  @@map("campaigns")
}

model Document {
  id           String       @id @default(uuid()) @db.Uuid
  kind         DocumentKind
  caseId       String?      @map("case_id") @db.Uuid
  storageKey   String       @unique @map("storage_key")
  originalName String       @map("original_name")
  mimeType     String       @map("mime_type")
  sizeBytes    Int          @map("size_bytes")
  sha256       String
  uploadedById String       @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at")

  case         Case?         @relation(fields: [caseId], references: [id], onDelete: Restrict)
  uploadedBy   User          @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  disbursement Disbursement?

  @@map("documents")
}

model CollectionPoint {
  id          String              @id @default(uuid()) @db.Uuid
  name        String
  type        CollectionPointType @default(OTHER)
  contactName String?             @map("contact_name")
  area        String
  isActive    Boolean             @default(true) @map("is_active")
  createdAt   DateTime            @default(now()) @map("created_at")

  collectors User[]   @relation("CollectorPoints")
  pledges    Pledge[]

  @@map("collection_points")
}

model Pledge {
  id                 String        @id @default(uuid()) @db.Uuid
  referenceNo        String        @unique @map("reference_no")
  campaignId         String        @map("campaign_id") @db.Uuid
  donorId            String?       @map("donor_id") @db.Uuid
  donorName          String?       @map("donor_name")
  donorPhone         String?       @map("donor_phone")
  isAnonymousDisplay Boolean       @default(false) @map("is_anonymous_display")
  amount             Decimal       @db.Decimal(14, 2)
  currency           Currency
  channel            PledgeChannel
  method             PaymentMethod
  status             PledgeStatus
  isDemo             Boolean       @default(false) @map("is_demo")
  collectionPointId  String?       @map("collection_point_id") @db.Uuid
  recordedById       String?       @map("recorded_by_id") @db.Uuid
  officialReceiptNo  String?       @unique @map("official_receipt_no")
  verifiedAt         DateTime?     @map("verified_at")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  campaign        Campaign         @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  donor           User?            @relation("DonorPledges", fields: [donorId], references: [id], onDelete: SetNull)
  recordedBy      User?            @relation("RecordedPledges", fields: [recordedById], references: [id], onDelete: SetNull)
  collectionPoint CollectionPoint? @relation(fields: [collectionPointId], references: [id], onDelete: Restrict)
  receipts        Receipt[]
  verifications   Verification[]

  @@index([campaignId, status])
  @@index([donorId])
  @@map("pledges")
}

model Receipt {
  id           String   @id @default(uuid()) @db.Uuid
  pledgeId     String   @map("pledge_id") @db.Uuid
  storageKey   String   @unique @map("storage_key")
  mimeType     String   @map("mime_type")
  sizeBytes    Int      @map("size_bytes")
  sha256       String
  transferRef  String?  @map("transfer_ref")
  uploadedById String   @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  pledge        Pledge         @relation(fields: [pledgeId], references: [id], onDelete: Restrict)
  uploadedBy    User           @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  verifications Verification[]

  @@index([sha256])
  @@map("receipts")
}

model Verification {
  id         String             @id @default(uuid()) @db.Uuid
  pledgeId   String             @map("pledge_id") @db.Uuid
  receiptId  String?            @map("receipt_id") @db.Uuid
  status     VerificationStatus @default(PENDING)
  reviewerId String?            @map("reviewer_id") @db.Uuid
  reason     String?
  createdAt  DateTime           @default(now()) @map("created_at")
  decidedAt  DateTime?          @map("decided_at")

  pledge   Pledge   @relation(fields: [pledgeId], references: [id], onDelete: Restrict)
  receipt  Receipt? @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  reviewer User?    @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@map("verifications")
}

model Disbursement {
  id                String   @id @default(uuid()) @db.Uuid
  campaignId        String   @map("campaign_id") @db.Uuid
  hospitalId        String   @map("hospital_id") @db.Uuid
  amount            Decimal  @db.Decimal(14, 2)
  currency          Currency
  invoiceDocumentId String   @unique @map("invoice_document_id") @db.Uuid
  note              String?
  paidAt            DateTime @map("paid_at")
  recordedById      String   @map("recorded_by_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  campaign        Campaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  hospital        Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  invoiceDocument Document @relation(fields: [invoiceDocumentId], references: [id], onDelete: Restrict)
  recordedBy      User     @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  @@map("disbursements")
}

model CampaignUpdate {
  id         String   @id @default(uuid()) @db.Uuid
  campaignId String   @map("campaign_id") @db.Uuid
  authorId   String   @map("author_id") @db.Uuid
  bodyAr     String   @map("body_ar")
  bodyEn     String?  @map("body_en")
  createdAt  DateTime @default(now()) @map("created_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@map("campaign_updates")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String // e.g. case.approve, pledge.verify, campaign.hospital_change
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@map("audit_logs")
}

model ImportJob {
  id          String       @id @default(uuid()) @db.Uuid
  kind        ImportKind
  status      ImportStatus @default(PREVIEW)
  fileName    String       @map("file_name")
  storageKey  String?      @map("storage_key")
  mapping     Json?
  totalRows   Int          @default(0) @map("total_rows")
  validRows   Int          @default(0) @map("valid_rows")
  errorRows   Int          @default(0) @map("error_rows")
  errors      Json?
  createdById String       @map("created_by_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at")
  committedAt DateTime?    @map("committed_at")

  createdBy     User          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  beneficiaries Beneficiary[]

  @@map("import_jobs")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String
  title     String
  body      String
  link      String?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}
