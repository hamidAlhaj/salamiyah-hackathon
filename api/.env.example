# Copy to .env and fill in. Never commit .env.
DATABASE_URL="postgresql://majlis:<your-password>@localhost:5432/majlis_fund?schema=public"
PORT=4000
# Comma-separated list of allowed browser origins (web + Expo web).
WEB_ORIGIN="http://localhost:3000,http://localhost:8081"
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="<generate 64 random bytes>"
JWT_EXPIRES_IN="8h"
# Generate the same way as JWT_SECRET (a different value).
NATIONAL_ID_HMAC_KEY="<generate 64 random bytes>"
STORAGE_LOCAL_DIR="uploads"
PUBLIC_WEB_URL="http://localhost:3000"
DEMO_MODE="true"
SLA_DAYS=7
# Live demo only: team WhatsApp numbers, comma-separated ("+963...,+963..."). Leave empty to use fictional numbers.
DEMO_WHATSAPP_NUMBERS=""
