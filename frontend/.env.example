# Copy to .env. Server-only values: never prefix them with NEXT_PUBLIC_.
NEST_API_URL="http://localhost:4000"
# Public site URL, used for share and QR links (server-side only).
SITE_URL="http://localhost:3000"
NODE_ENV="development"
# Secure flag of the session cookie: default on in production, off in development. Set "false" only
# for the LAN demo, where a production build is served over plain HTTP (http://<LAN-IP>:3000) and
# browsers would drop a Secure cookie (login fails on phones). Never "false" behind HTTPS.
SESSION_COOKIE_SECURE=""
