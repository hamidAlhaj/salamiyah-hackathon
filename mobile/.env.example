# On a real phone use this PC's LAN address instead of localhost (localhost would be the phone itself).
# Find it with `ipconfig` (Wi-Fi adapter, IPv4 Address), e.g. http://192.168.1.10:4000
EXPO_PUBLIC_API_URL=http://<LAN-IP>:4000
# The web app, for links to public pages (official receipts).
EXPO_PUBLIC_SITE_URL=http://<LAN-IP>:3000
