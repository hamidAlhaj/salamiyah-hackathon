{
  "expo": {
    "name": "أثر",
    "slug": "athar",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/brand/athar-icon.png",
    "scheme": "athar",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#eef2ef",
    "android": {
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/athar-icon.png",
        "backgroundColor": "#15803D"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/athar-logo.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/brand/athar-logo-dark.png",
            "backgroundColor": "#0B3D2A"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "نحتاج الكاميرا لتصوير إيصال التحويل.",
          "photosPermission": "نحتاج الصور لاختيار إيصال التحويل."
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": true
        }
      ],
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "reactCompiler": true
    },
    "ios": {
      "icon": "./assets/brand/athar-icon.png"
    },
    "web": {
      "favicon": "./assets/brand/athar-icon.png"
    }
  }
}
